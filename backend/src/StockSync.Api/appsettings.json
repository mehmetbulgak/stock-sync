{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "stocksync",
    "Audience": "stocksync-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "SessionLifetimeDays": 30
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "SessionPermitLimit": 60,
    "ApiPermitLimit": 300,
    "WindowSeconds": 60
  },
  "LoginThrottling": {
    "MaxFailuresPerAccount": 10,
    "WindowMinutes": 15
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownNetworks": []
  }
}
